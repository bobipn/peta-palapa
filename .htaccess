# ==============================================================================
# KONFIGURASI KEAMANAN SERVER LITESPEED / CPANEL - KOMERSIALLTI.MY.ID
# ==============================================================================
Options -Indexes
ServerSignature Off

<IfModule mod_headers.c>
    Header set Content-Security-Policy "default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval'; img-src 'self' https: data: blob: *.googleapis.com *.gstatic.com; font-src 'self' https: data: fonts.gstatic.com; connect-src 'self' https: *.googleapis.com;"
    Header set X-Frame-Options "DENY"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    Header unset X-Powered-By
</IfModule>

# ------------------------------------------------------------------------------
# CACHE: halaman .html TIDAK BOLEH di-cache browser/proxy.
# Semua halaman berisi gerbang login berbasis sesi (localStorage) yang
# dievaluasi di sisi klien -- kalau browser menyimpan salinan lama, orang yang
# sudah logout / sesi kedaluwarsa bisa saja masih melihat versi halaman lama
# (efek "nempel"). File statis non-HTML (gambar/font dari CDN) tidak terkena
# aturan ini karena sudah di-cache oleh domain CDN masing-masing, bukan domain ini.
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

<FilesMatch "\.(ini|log|sh|sql|yml|yaml|md|zip|tar|gz|git|env)$">
    Require all denied
</FilesMatch>

RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
    # Standar terbaru
    Header set Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), autoplay=(self)"
    # Kompatibilitas lama (opsional; abaikan jika error)
    Header set Feature-Policy "camera 'self'; microphone 'self'; display-capture 'self'"
</IfModule>

# ----------------------------------------------------------------------------
# (OPSIONAL) Paksa HTTPS — mikrofon/kamera HANYA jalan di https://
# Aktifkan (hapus tanda #) HANYA jika SSL sudah terpasang di domain Anda.
# ----------------------------------------------------------------------------
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
<IfModule mod_headers.c>

    # --- 1) Izinkan Kamera, Mikrofon, & Berbagi Layar ---
    Header set Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), autoplay=(self)"
    Header set Feature-Policy "camera 'self'; microphone 'self'; display-capture 'self'"

    # --- 2) Izinkan blob: di Content-Security-Policy ---
    # WAJIB agar PREVIEW hasil rekaman (video/audio) bisa diputar di halaman.
    # CSP Anda saat ini: default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval'
    # (tidak ada blob: → preview rekaman diblokir).
    #
    # Cara A (disarankan) — sisipkan blob: ke kebijakan yang sudah ada:
    Header always edit Content-Security-Policy "default-src" "default-src blob:"
    Header always edit Content-Security-Policy "media-src" "media-src blob:"

    # Cara B (jika Cara A tidak berpengaruh) — timpa penuh dengan kebijakan lengkap.
    # Hapus tanda # pada baris di bawah DAN beri # pada dua baris "Header always edit" di atas.
    # Header always set Content-Security-Policy "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; media-src 'self' https: data: blob:; img-src 'self' https: data: blob:; worker-src 'self' blob:; frame-src 'self' https:; connect-src 'self' https: wss: blob:"

</IfModule>

# ----------------------------------------------------------------------------
# (OPSIONAL) Paksa HTTPS — mikrofon/kamera HANYA jalan di https://
# Aktifkan (hapus #) HANYA jika SSL sudah terpasang.
# ----------------------------------------------------------------------------
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ============================================================================
#  CATATAN PENTING
#  Jika CSP tetap memblokir setelah ini, berarti header CSP dipasang oleh
#  PLUGIN KEAMANAN cPanel (mis. Imunify360 / "Security Optimization") atau oleh
#  hosting — bukan oleh .htaccess. Solusinya: nonaktifkan/atur CSP di panel
#  plugin tersebut agar menyertakan "blob:", atau minta bantuan hosting.
#  (Aplikasi tetap aman: rekaman selalu bisa DIUNDUH walau preview diblokir,
#   dan untuk berkas kecil aplikasi otomatis memakai data: sebagai cadangan.)
# ============================================================================
