# Optional. Without these the app runs in local mode (data stays in this browser's localStorage).
# With them, sign-in (email + Google) and data sync use your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: deploy under a sub-path, e.g. /edufin
NEXT_PUBLIC_BASE_PATH=
