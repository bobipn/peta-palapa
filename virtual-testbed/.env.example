# Copy to .env (never commit .env). All values are for a SIMULATED environment.
NODE_ENV=production
PORT=8080
# postgres://user:pass@host:5432/db   |   pglite:///absolute/path/to/data   |   pglite://memory
DATABASE_URL=pglite:///home/USER/cring-data
# Password for every seeded demo user. Required in production.
DEMO_PASSWORD=
SESSION_TTL_HOURS=12
COOKIE_SECURE=true
TRUST_PROXY=true
# Real-time ms per simulation tick (0 = off) and workflow worker interval
AUTO_TICK_MS=5000
WORKER_INTERVAL_MS=1000
RATE_LIMIT_PER_MINUTE=600
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Outbound fetch allowlist (empty = default-deny)
EGRESS_ALLOWLIST=
